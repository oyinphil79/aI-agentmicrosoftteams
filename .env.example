# "mock" runs fully offline. "azure" uses real Foundry / Azure services.
OPS_COPILOT_MODE=mock

# --- Azure (only needed when OPS_COPILOT_MODE=azure). No keys: auth uses Managed Identity / DefaultAzureCredential.
AZURE_OPENAI_ENDPOINT=https://<ai-services>.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_ROUTER_DEPLOYMENT=gpt-4.1-mini
AZURE_AI_PROJECT_ENDPOINT=https://<ai-services>.services.ai.azure.com/api/projects/<project>
AZURE_SEARCH_ENDPOINT=https://<search>.search.windows.net
AZURE_SEARCH_INDEX=policies
AZURE_CONTENT_SAFETY_ENDPOINT=https://<ai-services>.cognitiveservices.azure.com/

# --- Teams bot (Entra app registration used by Azure Bot Service)
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=UserManagedIdentity

# --- MCP ticketing server
TICKETS_MCP_URL=http://localhost:8765/mcp
